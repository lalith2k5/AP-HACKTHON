# StoreSignal AI — environment template (spec 5.1)
# Copy to .env and edit locally. NEVER commit .env.

STORESIGNAL_ENV=development
STORESIGNAL_DATA_DIR=/Users/YOUR_USER/storesignal-ai/data
STORESIGNAL_CONFIG_DIR=/Users/YOUR_USER/storesignal-ai/config
STORESIGNAL_MODEL_DIR=/Users/YOUR_USER/storesignal-ai/models
STORESIGNAL_REPORT_DIR=/Users/YOUR_USER/storesignal-ai/reports
STORESIGNAL_LOG_DIR=/Users/YOUR_USER/storesignal-ai/logs
STORESIGNAL_LOG_LEVEL=INFO
STORESIGNAL_DEMO_MODE=true
STORESIGNAL_API_KEY=replace-with-a-private-local-value
STORESIGNAL_ALLOW_HIDDEN_EVAL=false
STORESIGNAL_MAX_UPLOAD_MB=100
STORESIGNAL_MAX_ROWS=500000
STORESIGNAL_TIMEZONE=Asia/Kolkata
