# StoreSignal AI — environment template (spec 5.1)
# Copy to .env and edit locally. NEVER commit .env.

STORESIGNAL_ENV=development
STORESIGNAL_DATA_DIR=/Users/YOUR_USER/storesignal-ai/data
STORESIGNAL_CONFIG_DIR=/Users/YOUR_USER/storesignal-ai/config
STORESIGNAL_MODEL_DIR=/Users/YOUR_USER/storesignal-ai/models
STORESIGNAL_REPORT_DIR=/Users/YOUR_USER/storesignal-ai/reports
STORESIGNAL_LOG_DIR=/Users/YOUR_USER/storesignal-ai/logs
STORESIGNAL_LOG_LEVEL=INFO
STORESIGNAL_DEMO_MODE=true
STORESIGNAL_API_KEY=replace-with-a-private-local-value
STORESIGNAL_ALLOW_HIDDEN_EVAL=false
STORESIGNAL_MAX_UPLOAD_MB=100
STORESIGNAL_MAX_ROWS=500000
STORESIGNAL_TIMEZONE=Asia/Kolkata

# Next.js proxy (web/.env.local)
STORESIGNAL_API_BASE=http://localhost:8790
STORESIGNAL_API_KEY=demo-key-storesignal

# OIDC (optional; when enabled, Bearer tokens are accepted alongside x-api-key)
STORESIGNAL_OIDC_ENABLED=false
STORESIGNAL_OIDC_ISSUER=https://your-idp.example.com/realms/storesignal
STORESIGNAL_OIDC_AUDIENCE=storesignal-api
STORESIGNAL_OIDC_ROLE_CLAIM=realm_access.roles
# STORESIGNAL_OIDC_JWKS_URL=https://your-idp.example.com/realms/storesignal/protocol/openid-connect/certs

# Auth.js / NextAuth v5 (web/.env.local)
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3300
# OIDC — leave issuer empty to fall back to static x-api-key mode
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_ROLE_CLAIM=realm_access.roles
