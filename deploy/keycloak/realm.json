{
  "realm": "storesignal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "storesignal-api",
      "enabled": true,
      "publicClient": false,
      "secret": "storesignal-dev-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3300/api/auth/callback"],
      "webOrigins": ["http://localhost:3300"]
    }
  ],
  "roles": {
    "realm": [
      {"name": "admin"},
      {"name": "analyst"},
      {"name": "regional_ops_lead"},
      {"name": "store_manager"},
      {"name": "hr_sensitive"},
      {"name": "food_safety_risk"},
      {"name": "reviewer"},
      {"name": "supply_chain"}
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@storesignal.local",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["admin"]
    },
    {
      "username": "ops",
      "enabled": true,
      "email": "ops@storesignal.local",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["regional_ops_lead"]
    },
    {
      "username": "reviewer",
      "enabled": true,
      "email": "reviewer@storesignal.local",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["reviewer"]
    },
    {
      "username": "hr",
      "enabled": true,
      "email": "hr@storesignal.local",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["hr_sensitive"]
    }
  ]
}
