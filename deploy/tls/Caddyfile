# StoreSignal AI — Caddy reverse proxy
#
# Default: self-signed TLS on :8443 (LAN).
# For a real domain, replace the site line with:
#   storesignal.example.com
# and remove the 'tls internal' line.

:8443
tls internal

encode zstd gzip

header
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server

handle /api/*
    reverse_proxy 127.0.0.1:8790

handle
    reverse_proxy 127.0.0.1:3300
